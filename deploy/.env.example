# 用 scripts/server.py 读取，无 shell 变量展开。路径相对于项目根目录。
# HOST 只用于文档访问地址；Caddy 监听所有网卡，由 PORT 设置外部端口。
HOST=127.0.0.1
PORT=8080
BIND_HOST=0.0.0.0
USE_CADDY=true
API_UPSTREAM=127.0.0.1:18081
LISTEN_ADDR=127.0.0.1:18081
DB_FILE=backend/data/inspection.db
# 旧 JSON 仅导入一次，保持源文件不变；全新部署可留空。
LEGACY_JSON_FILE=backend/data/issues.json
FRONTEND_DIR=.cache/release/frontend
# 首次启动前填写 12～72 字节的初始密码。已有 Admin 时不会覆盖密码。
ADMIN_PASSWORD=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
